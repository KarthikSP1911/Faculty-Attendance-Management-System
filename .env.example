# Copy to apps/api/.env and replace the placeholders. Never commit the real file.
# Neon console: https://console.neon.tech -> your project -> Dashboard -> Connect

# Main branch, POOLED connection (host contains "-pooler"), keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Main branch, DIRECT (unpooled) connection; used by `prisma migrate`
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Create a separate Neon branch named "test" (Branches -> Create branch) and copy its URLs.
# TEST_DATABASE_URL = pooled URL of the test branch
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-test-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# TEST_DIRECT_URL = direct URL of the test branch
TEST_DIRECT_URL=postgresql://USER:PASSWORD@ep-test-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-chars

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000
