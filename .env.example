# Copy to apps/api/.env and fill in. Never commit the real file.
# Neon console: https://console.neon.tech -> your project -> Dashboard -> Connect

# Main branch, POOLED connection (host contains "-pooler"), keep ?sslmode=require
DATABASE_URL=
# Main branch, DIRECT (unpooled) connection; used by `prisma migrate`
DIRECT_URL=

# Create a separate Neon branch named "test" (Branches -> Create branch) and copy its URLs.
# TEST_DATABASE_URL = pooled URL of the test branch
TEST_DATABASE_URL=
# TEST_DIRECT_URL = direct URL of the test branch
TEST_DIRECT_URL=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000
