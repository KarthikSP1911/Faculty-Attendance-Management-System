# Copy to apps/api/.env. Start the database first: `docker compose up -d db`
# Local Docker Postgres (see docker-compose.yml). Never commit the real .env file.

DATABASE_URL=postgresql://fams:fams@localhost:5432/fams?schema=public
DIRECT_URL=postgresql://fams:fams@localhost:5432/fams?schema=public

# Integration tests run in a separate schema of the same database
TEST_DATABASE_URL=postgresql://fams:fams@localhost:5432/fams?schema=fams_test
TEST_DIRECT_URL=postgresql://fams:fams@localhost:5432/fams?schema=fams_test

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-chars

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000
